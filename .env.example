# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
SALESFORCE_AUTH_FLOW=client_credentials
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=

# stdio or http. The container image sets http.
MCP_TRANSPORT=http
PORT=8080

# Bind address when CONDUIT_S2S_SECRET is set. When MCP_HTTP_HOST is unset,
# a configured secret keeps HOST (default 0.0.0.0). Without a usable secret
# the HTTP server binds 127.0.0.1. The container image sets 0.0.0.0.
MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder. Value is the
# gateway-provisioned service-to-service secret. Never commit a real secret.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without a usable
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and listens on 127.0.0.1 even if MCP_HTTP_HOST is a wider address.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: gateway (required X-Salesforce-* headers; no env
# fallback) or env (SALESFORCE_* above). The container image and Compose set
# gateway. Stdio reads SALESFORCE_* from the environment.
AUTH_MODE=gateway

LOG_LEVEL=info
